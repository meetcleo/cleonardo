{
  "name": "Cleonardo",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint ./packages",
    "generate-image-config": "tsx scripts/generate-image-config.ts",
    "generate-images": "tsx scripts/generate-images.ts",
    "tokens:transform": "node packages/tokens/scripts/transform.mjs",
    "tokens:check": "node packages/tokens/scripts/transform.mjs --check",
    "tokens:verify": "node packages/tokens/scripts/verify-tokens.mjs",
    "tokens:test": "vitest run --root packages/tokens",
    "tokens:typecheck": "tsc -p packages/tokens/tsconfig.json",
    "tokens:build": "tsc -p packages/tokens/tsconfig.build.json",
    "plugin:build": "node packages/figma-plugins/tokens-sync/scripts/build.mjs",
    "plugin:watch": "node packages/figma-plugins/tokens-sync/scripts/build.mjs --watch",
    "plugin:typecheck": "tsc --noEmit --project packages/figma-plugins/tokens-sync"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.36.0",
    "@figma/plugin-typings": "^1.109.0",
    "esbuild": "^0.25.0",
    "typescript-eslint": "^8.35.0",
    "dotenv": "^8.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.0",
    "tsx": "^4.19.3",
    "typescript": "5.5.4",
    "sharp": "^0.34.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {},
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
